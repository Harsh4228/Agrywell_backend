# --- Server ---
NODE_ENV=production
PORT=5000

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used only by `npm run seed:admin` to create / reset the admin login
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=https://www.example.com,https://admin.example.com

# --- Contact form email (Resend) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Must be a domain verified in Resend for delivery to arbitrary recipients
CONTACT_FROM_EMAIL=Agriwell Website <noreply@yourdomain.com>

# --- Uploads ---
UPLOAD_MAX_MB=10
